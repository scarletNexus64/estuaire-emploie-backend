[Unit]
Description=Estuaire Emploi - Company Recovery Delivery Worker
After=network.target mysql.service redis-server.service

[Service]
User=web19
Group=client1
WorkingDirectory=/var/www/clients/client1/web19/web/estuaire-emploie-backend
ExecStart=/usr/bin/php artisan queue:work redis --queue=company-recovery --tries=4 --timeout=60 --sleep=1 --max-jobs=500 --max-time=3600
Restart=always
RestartSec=5
StandardOutput=append:/var/www/clients/client1/web19/web/estuaire-emploie-backend/storage/logs/queue-company-recovery.log
StandardError=append:/var/www/clients/client1/web19/web/estuaire-emploie-backend/storage/logs/queue-company-recovery-error.log

[Install]
WantedBy=multi-user.target
